@page "/"
@layout EmptyLayout
@inject NavigationManager Nav
@inject ProgressService Progress

<PageTitle>Codeigo — Learn Syntax in Five-Minute Drills</PageTitle>

<div class="bg-white min-h-screen flex flex-col font-sans">
    <!-- Top Navigation Bar -->
    <header class="w-full max-w-7xl mx-auto px-6 sm:px-12 md:px-24 h-20 flex items-center justify-between">
        <div class="logo p-0" @onclick='() => Nav.NavigateTo("/")'>
            <span class="logo-icon">{}</span>
            <span>Codeigo</span>
        </div>
        <div class="flex gap-5 items-center font-semibold">
            @if (Progress.IsLoggedIn)
            {
                <span class="text-ink">Hi, @Progress.UserName</span>
                <button class="btn sm" @onclick='() => Nav.NavigateTo("/learn")'>Open App</button>
            }
            else
            {
                <button class="btn o sm" @onclick='() => { Progress.Login("Ethan"); Nav.NavigateTo("/learn"); }'>Log in</button>
            }
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 py-14 flex flex-col lg:flex-row gap-14 items-center bg-surface rounded-3xl my-4">
        <div class="flex-1 max-w-xl flex flex-col gap-6">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-ink">
                Learn to code in five-minute drills
            </h1>
            <p class="text-lg sm:text-xl leading-relaxed text-mut">
                Practice real syntax in Python, JavaScript, and C++. Short lessons, instant feedback, and quizzes you can make yourself.
            </p>
            <div class="flex gap-3.5 mt-2 flex-wrap">
                <button class="btn lg" @onclick='() => Nav.NavigateTo("/learn")'>Get started</button>
                <button class="btn o lg" @onclick='() => { Progress.Login("Ethan"); Nav.NavigateTo("/learn"); }'>I already have an account</button>
            </div>
        </div>

        <!-- Interactive Demo Card -->
        <div class="flex-1 max-w-lg w-full">
            <div class="card anim-pop rounded-3xl p-7 flex flex-col gap-4 shadow-[0_8px_0_theme(colors.line)]">
                <div class="flex justify-between items-center">
                    <span class="tag">Fill in the blank</span>
                    <span class="pill text-mint-dark text-base font-bold">✦ Interactive Demo</span>
                </div>
                <div class="text-xl font-bold text-ink">Finish the loop so it runs 5 times</div>
                
                <div class="code-window">
                    <div class="code-line text-lg">
                        <span class="ln-num w-11 pr-4">1</span>
                        <span><b class="kw">for</b> i <b class="kw">in</b> <span class="blank @(_demoChoice == "range" ? "ok" : _demoChoice != null ? "bad" : "")" style="min-width: 84px;">@(_demoChoice ?? "_____")</span>(5):</span>
                    </div>
                    <div class="code-line text-lg">
                        <span class="ln-num w-11 pr-4">2</span>
                        <span>    <b class="fn">print</b>(i)</span>
                    </div>
                </div>

                <!-- Choice keys -->
                <div class="flex gap-2.5">
                    <div class="key-chip @(_demoChoice == "range" ? "used" : "") h-12 text-base" @onclick='() => SelectDemoKey("range")'>range</div>
                    <div class="key-chip @(_demoChoice == "len" ? "used" : "") h-12 text-base" @onclick='() => SelectDemoKey("len")'>len</div>
                    <div class="key-chip @(_demoChoice == "while" ? "used" : "") h-12 text-base" @onclick='() => SelectDemoKey("while")'>while</div>
                </div>

                @if (_demoChoice == "range")
                {
                    <div class="anim-fade-up bg-mint-tint rounded-2xl p-4 flex gap-4 items-center text-mint-dark">
                        <div class="mascot sm w-11 h-11 rounded-2xl">
                            <i class="eye" style="top: 14px; left: 10px; width: 7px; height: 10px;"></i>
                            <i class="eye" style="top: 14px; right: 10px; width: 7px; height: 10px;"></i>
                            <b class="mouth" style="left: 16px; top: 29px; width: 12px; height: 6px;"></b>
                        </div>
                        <div class="flex-1">
                            <div class="font-bold text-lg">Nicely done!</div>
                            <div class="text-sm">range(5) counts from 0 to 4 in Python.</div>
                        </div>
                        <button class="btn g sm" @onclick='() => Nav.NavigateTo("/learn")'>Try More</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_demoChoice))
                {
                    <div class="anim-shake bg-coral-tint rounded-2xl p-4 flex gap-4 items-center text-coral-dark">
                        <div class="mascot sm sad w-11 h-11 rounded-2xl">
                            <i class="eye" style="top: 14px; left: 10px; width: 7px; height: 10px;"></i>
                            <i class="eye" style="top: 14px; right: 10px; width: 7px; height: 10px;"></i>
                            <b class="mouth" style="left: 16px; top: 31px; width: 12px; height: 6px;"></b>
                        </div>
                        <div class="flex-1">
                            <div class="font-bold text-lg">Not quite</div>
                            <div class="text-sm">Try selecting <code>range</code> to generate a sequence!</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Language Selector Cards -->
    <section class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 pt-16 pb-8 text-center">
        <h2 class="text-3xl font-bold mb-6 text-ink">Pick a language and start typing</h2>
        <div class="flex gap-6 justify-center flex-wrap">
            <div class="card w-64 border-sky cursor-pointer text-left hover:-translate-y-1 transition-transform" 
                 @onclick='() => ChooseLangAndStart("python")'>
                <div class="text-2xl font-bold text-sky-dark">🐍 Python</div>
                <div class="text-mut text-sm mt-1.5">5 tracks, 15+ lessons</div>
                <div class="mt-4 flex items-center gap-1.5 text-sky-dark font-bold text-sm">
                    Start Python &rarr;
                </div>
            </div>

            <div class="card w-64 border-sun cursor-pointer text-left hover:-translate-y-1 transition-transform" 
                 @onclick='() => ChooseLangAndStart("javascript")'>
                <div class="text-2xl font-bold text-sun-dark">🟨 JavaScript</div>
                <div class="text-mut text-sm mt-1.5">5 tracks, 12+ lessons</div>
                <div class="mt-4 flex items-center gap-1.5 text-sun-dark font-bold text-sm">
                    Start JavaScript &rarr;
                </div>
            </div>

            <div class="card w-64 border-coral cursor-pointer text-left hover:-translate-y-1 transition-transform" 
                 @onclick='() => ChooseLangAndStart("cpp")'>
                <div class="text-2xl font-bold text-coral-dark">⚙️ C++</div>
                <div class="text-mut text-sm mt-1.5">5 tracks, 10+ lessons</div>
                <div class="mt-4 flex items-center gap-1.5 text-coral-dark font-bold text-sm">
                    Start C++ &rarr;
                </div>
            </div>
        </div>
    </section>

    <!-- Three Value Pillars -->
    <section class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 py-12 flex gap-6 flex-wrap">
        <div class="card flex-1 min-w-[280px] p-7">
            <div class="logo-icon mb-4" style="background: var(--sun); box-shadow: 0 3px 0 var(--sund);">5</div>
            <h3 class="text-2xl font-bold my-3 text-ink">Short lessons</h3>
            <p class="text-mut text-base leading-relaxed">
                Each lesson is five to ten quick exercises. Finish one in the time it takes to brew coffee.
            </p>
        </div>

        <div class="card flex-1 min-w-[280px] p-7">
            <div class="logo-icon mb-4" style="background: var(--mint); box-shadow: 0 3px 0 var(--mintd);">✓</div>
            <h3 class="text-2xl font-bold my-3 text-ink">Feedback that teaches</h3>
            <p class="text-mut text-base leading-relaxed">
                Mistakes show up with plain-English explanations of syntax and semantics, not cryptic walls of text.
            </p>
        </div>

        <div class="card flex-1 min-w-[280px] p-7">
            <div class="logo-icon mb-4" style="background: var(--sky); box-shadow: 0 3px 0 var(--skyd);">+</div>
            <h3 class="text-2xl font-bold my-3 text-ink">Make your own quizzes</h3>
            <p class="text-mut text-base leading-relaxed">
                Turn any code snippet into a drill with the Create mode builder, then share it with students or peers.
            </p>
        </div>
    </section>

    <!-- Create Mode Feature Callout -->
    <section class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 py-14 flex flex-col md:flex-row gap-14 items-center bg-surface rounded-3xl my-6">
        <div class="flex-1 min-w-[300px] flex flex-col gap-4">
            <h2 class="text-3xl sm:text-4xl font-bold leading-tight text-ink">Build a quiz in a minute</h2>
            <p class="text-lg leading-relaxed text-mut">
                Pick a question type, paste your code, and mark the blank with <code>[[ ]]</code>. Codeigo extracts tokens and generates live interactive previews instantly.
            </p>
            <div class="mt-2">
                <button class="btn" @onclick='() => Nav.NavigateTo("/create")'>Try Create mode</button>
            </div>
        </div>

        <div class="card flex-1 min-w-[300px] p-6 flex flex-col gap-2 w-full">
            <div class="lbl">Question type</div>
            <div class="inp mb-3 pointer-events-none">Fill in the blank</div>
            <div class="lbl">Code (wrap the blank in [[ ]])</div>
            <div class="inp code-inp mb-0 min-h-[90px]">for i in [[range]](5):
    print(i)</div>
        </div>
    </section>

    <!-- Bottom Mascot CTA Banner -->
    <section class="max-w-7xl mx-auto px-6 sm:px-12 md:px-24 py-12 w-full">
        <div class="bg-brand rounded-3xl p-8 sm:p-14 flex flex-col sm:flex-row justify-between items-center shadow-[0_8px_0_theme(colors.brand.dark)] gap-6">
            <div class="flex gap-7 items-center">
                <div class="mascot bg-white shadow-[0_4px_0_theme(colors.line)]">
                    <i class="eye" style="background: var(--p);"></i>
                    <i class="eye" style="background: var(--p);"></i>
                    <b class="mouth"></b>
                </div>
                <div class="text-white">
                    <div class="text-2xl sm:text-3xl font-bold">Write your first line today</div>
                    <div class="text-base opacity-90 mt-1">Free to start. No setup, no installs.</div>
                </div>
            </div>
            <button class="btn lg bg-white text-brand shadow-[0_4px_0_theme(colors.line)] hover:bg-slate-50" @onclick='() => Nav.NavigateTo("/learn")'>
                Get started
            </button>
        </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-7xl w-full mx-auto px-6 sm:px-12 md:px-24 py-8 mt-auto flex flex-col sm:flex-row justify-between items-center text-mut text-sm gap-4">
        <div class="logo p-0 text-xl">
            <span class="logo-icon w-7 h-7 text-xs">{}</span>
            <span>Codeigo</span>
        </div>
        <div class="flex gap-6 items-center">
            <a href="learn" class="hover:text-ink">Learn</a>
            <a href="create" class="hover:text-ink">Create</a>
            <a href="profile" class="hover:text-ink">Profile</a>
        </div>
    </footer>
</div>

@code {
    private string? _demoChoice = null;

    private void SelectDemoKey(string key)
    {
        _demoChoice = key;
    }

    private void ChooseLangAndStart(string lang)
    {
        Progress.SetLanguage(lang);
        Nav.NavigateTo("/learn");
    }
}
