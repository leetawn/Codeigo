@page "/settings"
@inject ProgressService Progress
@inject ContentService Content
@implements IDisposable

<PageTitle>Settings — Codeigo</PageTitle>

<div style="padding: 36px 48px; max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px;" class="anim-fade-up">
    <div>
        <h1 style="font-size: 36px; font-weight: 700; color: var(--ink);">Settings</h1>
        <p style="color: var(--mut); margin-top: 4px;">Customize your practice experience, goals, and interface.</p>
    </div>

    <!-- Daily Goal -->
    <div class="card" style="padding: 24px;">
        <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">Daily XP Goal</h3>
        <p style="color: var(--mut); font-size: 14px; margin-bottom: 16px;">Set how much XP you want to earn each day to maintain your streak.</p>
        <div style="display: flex; gap: 12px;">
            @foreach (var goal in new[] { 20, 30, 50 })
            {
                var isSelected = Progress.DailyGoal == goal;
                <div class="chip @(isSelected ? "on" : "")" style="cursor: pointer;" @onclick="() => Progress.DailyGoal = goal">
                    @goal XP / day
                </div>
            }
        </div>
    </div>

    <!-- Hearts Mode -->
    <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 4px;">Hearts System</h3>
                <p style="color: var(--mut); font-size: 14px;">Lose hearts on wrong answers. Off by default for relaxed drills.</p>
            </div>
            <button class="btn @(Progress.HeartsEnabled ? "r" : "o") sm" 
                    @onclick="ToggleHearts">
                @(Progress.HeartsEnabled ? "Enabled (♥ 5)" : "Disabled")
            </button>
        </div>
    </div>

    <!-- Default Language -->
    <div class="card" style="padding: 24px;">
        <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">Active Curriculum</h3>
        <p style="color: var(--mut); font-size: 14px; margin-bottom: 16px;">Choose your primary coding language for lessons and navigation.</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            @foreach (var lang in Content.Languages)
            {
                var isSelected = Progress.CurrentLanguage == lang.Id;
                <div class="chip @(lang.AccentClass) @(isSelected ? "on" : "")" style="cursor: pointer;" @onclick="() => Progress.SetLanguage(lang.Id)">
                    @lang.Emoji @lang.DisplayName
                </div>
            }
        </div>
    </div>

    <!-- Account Details -->
    <div class="card" style="padding: 24px;">
        <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">Account</h3>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
            <div>
                <div style="font-weight: 700; font-size: 16px;">@Progress.UserName</div>
                <div style="font-size: 13px; color: var(--mut);">@(Progress.IsLoggedIn ? "Logged in account" : "Guest user")</div>
            </div>
            @if (Progress.IsLoggedIn)
            {
                <button class="btn o sm" @onclick="Progress.Logout">Sign Out</button>
            }
            else
            {
                <button class="btn sm" @onclick='() => Progress.Login("Ethan")'>Sign In</button>
            }
        </div>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        Progress.OnChange += StateHasChanged;
    }

    private void ToggleHearts()
    {
        Progress.HeartsEnabled = !Progress.HeartsEnabled;
        if (Progress.HeartsEnabled)
        {
            Progress.ResetHearts();
        }
    }

    public void Dispose()
    {
        Progress.OnChange -= StateHasChanged;
    }
}
