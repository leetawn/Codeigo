@page "/settings"
@inject ProgressService Progress
@inject ContentService Content
@implements IDisposable

<PageTitle>Settings — Codeigo</PageTitle>

<div class="p-8 max-w-2xl mx-auto flex flex-col gap-6 anim-fade-up">
    <div>
        <h1 class="text-3xl font-bold text-ink">Settings</h1>
        <p class="text-mut text-sm mt-1">Customize your practice experience, goals, and interface.</p>
    </div>

    <!-- Daily Goal -->
    <div class="card p-6">
        <h3 class="text-xl font-bold text-ink mb-2">Daily XP Goal</h3>
        <p class="text-mut text-sm mb-4">Set how much XP you want to earn each day to maintain your streak.</p>
        <div class="flex gap-3">
            @foreach (var goal in new[] { 20, 30, 50 })
            {
                var isSelected = Progress.DailyGoal == goal;
                <div class="chip @(isSelected ? "on" : "") cursor-pointer" @onclick="() => Progress.DailyGoal = goal">
                    @goal XP / day
                </div>
            }
        </div>
    </div>

    <!-- Hearts Mode -->
    <div class="card p-6">
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
            <div>
                <h3 class="text-xl font-bold text-ink mb-1">Hearts System</h3>
                <p class="text-mut text-sm">Lose hearts on wrong answers. Off by default for relaxed drills.</p>
            </div>
            <button class="btn @(Progress.HeartsEnabled ? "r" : "o") sm self-start sm:self-auto" 
                    @onclick="ToggleHearts">
                @(Progress.HeartsEnabled ? "Enabled (♥ 5)" : "Disabled")
            </button>
        </div>
    </div>

    <!-- Default Language -->
    <div class="card p-6">
        <h3 class="text-xl font-bold text-ink mb-2">Active Curriculum</h3>
        <p class="text-mut text-sm mb-4">Choose your primary coding language for lessons and navigation.</p>
        <div class="flex gap-3 flex-wrap">
            @foreach (var lang in Content.Languages)
            {
                var isSelected = Progress.CurrentLanguage == lang.Id;
                <div class="chip @(lang.AccentClass) @(isSelected ? "on" : "") cursor-pointer" @onclick="() => Progress.SetLanguage(lang.Id)">
                    @lang.Emoji @lang.DisplayName
                </div>
            }
        </div>
    </div>

    <!-- Account Details -->
    <div class="card p-6">
        <h3 class="text-xl font-bold text-ink mb-2">Account</h3>
        <div class="flex justify-between items-center mt-3">
            <div>
                <div class="font-bold text-base text-ink">@Progress.UserName</div>
                <div class="text-xs text-mut">@(Progress.IsLoggedIn ? "Logged in account" : "Guest user")</div>
            </div>
            @if (Progress.IsLoggedIn)
            {
                <button class="btn o sm" @onclick="Progress.Logout">Sign Out</button>
            }
            else
            {
                <button class="btn sm" @onclick='() => Progress.Login("Ethan")'>Sign In</button>
            }
        </div>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        Progress.OnChange += StateHasChanged;
    }

    private void ToggleHearts()
    {
        Progress.HeartsEnabled = !Progress.HeartsEnabled;
        if (Progress.HeartsEnabled)
        {
            Progress.ResetHearts();
        }
    }

    public void Dispose()
    {
        Progress.OnChange -= StateHasChanged;
    }
}
