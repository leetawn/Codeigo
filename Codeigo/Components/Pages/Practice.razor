@page "/practice"
@inject ContentService Content
@inject ProgressService Progress
@inject NavigationManager Nav

<PageTitle>Practice — Codeigo</PageTitle>

<div class="p-8 max-w-4xl mx-auto flex flex-col gap-7 anim-fade-up">
    <div>
        <h1 class="text-3xl font-bold text-ink">Practice Drills</h1>
        <p class="text-mut mt-1">Targeted exercises to reinforce syntax memory and fix weak spots.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="card flex flex-col justify-between border-sun shadow-sm hover:shadow-md transition-shadow">
            <div>
                <div class="logo-icon mb-3.5" style="background: var(--sun); box-shadow: 0 3px 0 var(--sund);">⚡</div>
                <h3 class="text-xl font-bold mb-2 text-ink">Rapid Loops Drill</h3>
                <p class="text-mut text-sm leading-relaxed">
                    Test bounds, syntax headers, and iterations across for and while loops.
                </p>
            </div>
            <button class="btn mt-5 w-full" @onclick='() => Nav.NavigateTo($"/lesson/{Progress.CurrentLanguage}/loops/py-loops-1")'>
                Start Drill (+15 XP)
            </button>
        </div>

        <div class="card flex flex-col justify-between border-mint shadow-sm hover:shadow-md transition-shadow">
            <div>
                <div class="logo-icon mb-3.5" style="background: var(--mint); box-shadow: 0 3px 0 var(--mintd);">✓</div>
                <h3 class="text-xl font-bold mb-2 text-ink">Basics & Types Refresh</h3>
                <p class="text-mut text-sm leading-relaxed">
                    Revisit variable declarations, assignments, and type rules.
                </p>
            </div>
            <button class="btn g mt-5 w-full" @onclick='() => Nav.NavigateTo($"/lesson/{Progress.CurrentLanguage}/basics/py-basics-1")'>
                Start Drill (+10 XP)
            </button>
        </div>

        <div class="card flex flex-col justify-between border-sky shadow-sm hover:shadow-md transition-shadow">
            <div>
                <div class="logo-icon mb-3.5" style="background: var(--sky); box-shadow: 0 3px 0 var(--skyd);">+</div>
                <h3 class="text-xl font-bold mb-2 text-ink">Custom Quiz Arena</h3>
                <p class="text-mut text-sm leading-relaxed">
                    Jump directly into community-authored and self-made quizzes.
                </p>
            </div>
            <button class="btn o mt-5 w-full" @onclick='() => Nav.NavigateTo("/create")'>
                Browse Quizzes &rarr;
            </button>
        </div>
    </div>
</div>
