@page "/profile"
@inject ProgressService Progress
@inject ContentService Content
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Profile — Codeigo</PageTitle>

<div class="p-8 max-w-4xl mx-auto flex flex-col gap-7 anim-fade-up">
    
    <!-- User Card -->
    <div class="card flex flex-col sm:flex-row gap-6 items-center p-8">
        <div class="mascot lg">
            <i class="eye"></i>
            <i class="eye"></i>
            <b class="mouth"></b>
        </div>
        <div class="flex-1 w-full text-center sm:text-left">
            <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-ink">@Progress.UserName</h1>
                    <div class="text-mut text-sm mt-0.5">Joined September 2026 • Syntax Enthusiast</div>
                </div>
                @if (Progress.IsLoggedIn)
                {
                    <button class="btn o sm" @onclick="Progress.Logout">Log Out</button>
                }
                else
                {
                    <button class="btn sm" @onclick='() => Progress.Login("Ethan")'>Sign In</button>
                }
            </div>

            <div class="flex justify-center sm:justify-start gap-6 mt-5">
                <div>
                    <span class="pill text-sun font-bold">🔥 @Progress.Streak</span>
                    <span class="text-xs text-mut block mt-0.5">Day streak</span>
                </div>
                <div>
                    <span class="pill text-sky font-bold">◆ @Progress.Xp</span>
                    <span class="text-xs text-mut block mt-0.5">Total XP</span>
                </div>
                <div>
                    <span class="pill text-mint font-bold">🎯 94%</span>
                    <span class="text-xs text-mut block mt-0.5">Avg accuracy</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Per-Language Progress -->
    <div>
        <h2 class="text-2xl font-bold text-ink mb-4">Language mastery</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var lang in Content.Languages)
            {
                var totalLessons = lang.Tracks.Sum(t => t.Lessons.Count);
                var completedLessons = lang.Tracks.Sum(t => t.Lessons.Count(l => Progress.IsLessonCompleted(l.Id)));
                var pct = totalLessons > 0 ? (int)Math.Round(completedLessons * 100.0 / totalLessons) : 0;

                <div class="card hover:border-brand transition-colors">
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-xl font-bold">@lang.Emoji @lang.DisplayName</span>
                        <span class="tag @lang.AccentClass">@completedLessons / @totalLessons</span>
                    </div>
                    <div class="bar">
                        <i class="bar-fill" style="width: @pct%;"></i>
                    </div>
                    <div class="mt-2 text-xs text-mut flex justify-between">
                        <span>@pct% completed</span>
                        <a href="learn" class="text-brand font-semibold hover:underline" @onclick="() => Progress.SetLanguage(lang.Id)">Practice &rarr;</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Badges & Achievements -->
    <div>
        <h2 class="text-2xl font-bold text-ink mb-4">Badges earned</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="card text-center p-5">
                <div class="text-4xl mb-2">🔥</div>
                <div class="font-bold text-base text-ink">Wildfire</div>
                <div class="text-xs text-mut mt-1">Reached a 10-day streak</div>
            </div>

            <div class="card text-center p-5">
                <div class="text-4xl mb-2">🐍</div>
                <div class="font-bold text-base text-ink">Pythonista</div>
                <div class="text-xs text-mut mt-1">Completed Python Basics</div>
            </div>

            <div class="card text-center p-5">
                <div class="text-4xl mb-2">🛠️</div>
                <div class="font-bold text-base text-ink">Quiz Creator</div>
                <div class="text-xs text-mut mt-1">Created a custom quiz</div>
            </div>

            <div class="card text-center p-5 opacity-60 bg-surface border-dashed">
                <div class="text-4xl mb-2">⚡</div>
                <div class="font-bold text-base text-ink">Polyglot</div>
                <div class="text-xs text-mut mt-1">Complete 3 languages</div>
            </div>
        </div>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        Progress.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Progress.OnChange -= StateHasChanged;
    }
}
