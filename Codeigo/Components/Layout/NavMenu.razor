@inject ProgressService Progress
@inject NavigationManager Nav
@implements IDisposable

<div class="logo" @onclick='() => Nav.NavigateTo("/")'>
    <span class="logo-icon">{}</span>
    <span>Codeigo</span>
</div>

<NavLink class="nav-item" href="learn" Match="NavLinkMatch.Prefix">
    <span class="nav-icon">
        <svg viewBox="0 0 24 24"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM3.45 9L12 4.34 20.55 9 12 13.66 3.45 9zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
    </span>
    <span>Learn</span>
</NavLink>

<NavLink class="nav-item" href="create" Match="NavLinkMatch.Prefix">
    <span class="nav-icon">
        <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
    </span>
    <span>Create</span>
</NavLink>

<NavLink class="nav-item" href="practice" Match="NavLinkMatch.Prefix">
    <span class="nav-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 14.5h-2v-2h2v2zm0-4h-2V7h2v5.5z"/></svg>
    </span>
    <span>Practice</span>
</NavLink>

<NavLink class="nav-item" href="profile" Match="NavLinkMatch.Prefix">
    <span class="nav-icon">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
    </span>
    <span>Profile</span>
</NavLink>

<NavLink class="nav-item" href="settings" Match="NavLinkMatch.Prefix">
    <span class="nav-icon">
        <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
    </span>
    <span>Settings</span>
</NavLink>

<div class="mt-auto" style="padding-top: 16px; border-top: 2px solid var(--line);">
    @if (Progress.IsLoggedIn)
    {
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 4px 6px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="mascot sm" style="width: 34px; height: 34px; border-radius: 10px;">
                    <i class="eye" style="top: 10px; width: 5px; height: 8px;"></i>
                    <i class="eye" style="top: 10px; width: 5px; height: 8px;"></i>
                    <b class="mouth" style="left: 11px; top: 22px; width: 10px; height: 5px;"></b>
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 14px;">@Progress.UserName</div>
                    <div style="font-size: 12px; color: var(--mut);">Author</div>
                </div>
            </div>
            <button class="btn o sm" style="height: 30px; padding: 0 10px; font-size: 12px;" @onclick="Progress.Logout">Exit</button>
        </div>
    }
    else
    {
        <div class="card" style="padding: 12px; text-align: center; border-radius: 14px; background: var(--bg);">
            <div style="font-weight: 700; font-size: 13px; margin-bottom: 4px;">Guest Mode</div>
            <div style="font-size: 11px; color: var(--mut); margin-bottom: 8px;">Sign in to access Create mode</div>
            <button class="btn sm" style="width: 100%; height: 34px; font-size: 13px;" @onclick='() => Progress.Login("Ethan")'>Sign In</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Progress.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Progress.OnChange -= StateHasChanged;
    }
}
