@inject ProgressService Progress
@inject ContentService Content
@inject NavigationManager Nav
@implements IDisposable

<div class="logo cursor-pointer select-none" @onclick="HandleLogoClick">
    <span class="logo-icon">{}</span>
    <span>Codeigo</span>
</div>

<!-- Language Indicator Chip in Sidebar -->
<div class="mb-3 px-2">
    <div class="flex items-center justify-between bg-surface rounded-xl p-2 border border-line text-xs font-semibold text-mut">
        <span class="flex items-center gap-1.5">
            <span class="text-sm">@(Content.GetLanguage(Progress.CurrentLanguage)?.Emoji ?? "🐍")</span>
            <span class="text-ink">@(Content.GetLanguage(Progress.CurrentLanguage)?.DisplayName ?? "Python")</span>
        </span>
        <button class="text-brand hover:underline font-bold" @onclick='() => Nav.NavigateTo("/settings")'>Switch</button>
    </div>
</div>

<div class="flex flex-col gap-1">
    <NavLink class="nav-item" href="learn" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM3.45 9L12 4.34 20.55 9 12 13.66 3.45 9zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
        </span>
        <span>Learn</span>
    </NavLink>

    <NavLink class="nav-item" href="practice" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 14.5h-2v-2h2v2zm0-4h-2V7h2v5.5z"/></svg>
        </span>
        <span>Practice</span>
    </NavLink>

    <NavLink class="nav-item" href="quests" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        </span>
        <span>Quests</span>
    </NavLink>

    <NavLink class="nav-item" href="leaderboard" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94A5.01 5.01 0 0011 15.9V19H7v2h10v-2h-4v-3.1c1.9-.36 3.42-1.78 3.9-3.66 2.47-.31 4.1-2.39 4.1-4.94V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"/></svg>
        </span>
        <span>Leaderboard</span>
    </NavLink>

    <NavLink class="nav-item" href="playground" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
        </span>
        <span>Playground</span>
    </NavLink>

    <NavLink class="nav-item" href="create" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        </span>
        <span>Create</span>
    </NavLink>

    <NavLink class="nav-item" href="profile" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </span>
        <span>Profile</span>
    </NavLink>

    <NavLink class="nav-item" href="settings" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
        <span class="nav-icon">
            <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
        </span>
        <span>Settings</span>
    </NavLink>
</div>

<!-- Account Section Footer -->
<div class="mt-auto pt-4 border-t-2 border-line">
    @if (Progress.IsLoggedIn)
    {
        <div class="flex items-center justify-between p-1">
            <div class="flex items-center gap-2.5">
                <div class="mascot sm w-9 h-9 rounded-xl">
                    <i class="eye" style="top: 8px; width: 5px; height: 8px;"></i>
                    <i class="eye" style="top: 8px; width: 5px; height: 8px;"></i>
                    <b class="mouth" style="left: 9px; top: 18px; width: 10px; height: 5px;"></b>
                </div>
                <div>
                    <div class="font-bold text-sm text-ink truncate max-w-[90px]">@Progress.UserName</div>
                    <div class="text-xs text-mut">Learner</div>
                </div>
            </div>
            <button class="btn o sm h-7 px-2.5 text-xs" @onclick="Progress.Logout">Exit</button>
        </div>
    }
    else
    {
        <div class="card p-3 text-center rounded-xl bg-surface">
            <div class="font-bold text-xs mb-1 text-ink">Guest Mode</div>
            <div class="text-[11px] text-mut mb-2 leading-tight">Sign in to save your streaks</div>
            <button class="btn sm w-full h-8 text-xs" @onclick='() => Progress.Login("Ethan")'>Sign In</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized()
    {
        Progress.OnChange += StateHasChanged;
    }

    private async Task HandleLogoClick()
    {
        Nav.NavigateTo("/");
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private async Task HandleNavClick()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    public void Dispose()
    {
        Progress.OnChange -= StateHasChanged;
    }
}
